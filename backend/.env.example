# =============================================
# FlowCheck Backend — Variables de entorno
# Copia este archivo a .env y completa los valores
# =============================================

# PostgreSQL (Supabase)
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=tu_password_de_base_de_datos

# JWT Secret de Supabase
# Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=tu_jwt_secret_de_supabase

# CORS — URL del frontend (separar múltiples con coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173
